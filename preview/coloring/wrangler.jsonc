{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixform-coloring-preview",
  "main": "../../worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "http://localhost:3015",
    "COLORING_PREVIEW_ENABLED": "true",
    "BILLING_ENABLED": "true"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "pixform-coloring-preview",
    "database_id": "00000000-0000-0000-0000-000000000015",
    "migrations_dir": "../../migrations", "remote": false
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pixform-coloring-preview", "remote": false }]
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pixform-text-preview",
  "account_id": "23e53b75ddd6ee2d8b80031f6a1e45e0",
  "main": "../../worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [],
  "assets": {
    "directory": "../../.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pixform-text-preview"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://pixform-text-preview.liukai19911010.workers.dev",
    "TEXT_REMOVER_PREVIEW_ENABLED": "true",
    "BILLING_ENABLED": "true",
    "COLORING_ENABLED": "false",
    "GENERATION_ENABLED": "false",
    "MULTIPLE_FACE_SWAP_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixform-text-preview",
      "database_id": "5da05cf8-f099-4e6a-9f4d-41f7dcb1baf5",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pixform-text-preview"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
